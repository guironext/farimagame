# Copiez ce fichier en .env.local puis relancez `npm run dev`.
# .env.local n'est jamais partagé (ignoré par git). Ne mettez jamais de clé dans le code.

# Vrais matchs (API-Football, https://www.api-football.com)
# API_FOOTBALL_KEY=
# Synchro complète (12 requêtes, une par compétition) toutes les N minutes (défaut 360 = 4 fois/jour = 48 requêtes)
# API_FOOTBALL_SYNC_MINUTES=360
# Direct : intervalle de base entre deux rafraîchissements (secondes, défaut 60). 1 requête pour 20 matchs en cours.
# Il est allongé automatiquement pour que le quota du jour tienne jusqu'à la fin des matchs du jour.
# API_FOOTBALL_LIVE_SECONDS=60
# Quota quotidien de votre offre (défaut 100 = offre gratuite ; lu aussi dans les en-têtes de réponse de l'API)
# API_FOOTBALL_DAILY_LIMIT=100

# Vraies cotes de bookmakers (The Odds API, https://the-odds-api.com) — offre gratuite : 500 crédits/mois
# ODDS_API_KEY=
# Délai minimal entre deux rafraîchissements des cotes (minutes, défaut 15 ; le quota restant est réparti sur le mois)
# ODDS_API_REFRESH_MINUTES=15

# Cotes affichées : taille du pot (F CFA) à partir de laquelle le pot pèse autant que la cote de référence
# BET_ODDS_BLEND_K=20000

# Connexion / inscription (Clerk, https://dashboard.clerk.com -> votre application -> API keys)
# Sans ces clés, `npm run dev` fonctionne quand même : Clerk crée une application de test temporaire (« keyless mode »).
# En production (`npm run build` + `npm start`), les deux clés sont obligatoires pour que les joueurs puissent se connecter.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Administrateurs : e-mails des comptes Clerk (séparés par des virgules). Recommandé : l'e-mail est vérifié par Clerk.
# ADMIN_EMAILS=vous@exemple.com
# (ou pseudos FarimaGame, séparés par des virgules ; moins sûr qu'un e-mail vérifié)
# ADMIN_USERNAMES=
# Maison : comptes qui gèrent l'argent (caisse, commissions, dépôts, retraits, règlement des mises).
# HOME_EMAILS=caisse@exemple.com
# HOME_USERNAMES=


# Database connection (Neon)
# DATABASE_URL : connexion poolée (le hostname contient -pooler), utilisée par l'application.
# DATABASE_URL_UNPOOLED : même chaîne sans -pooler, utilisée par Prisma Migrate et Prisma Studio.
DATABASE_URL=postgresql://<username>:<password>@<host>-pooler.<region>.aws.neon.tech/<database_name>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<username>:<password>@<host>.<region>.aws.neon.tech/<database_name>?sslmode=require

# Les clés Clerk se renseignent dans .env.local uniquement (voir les lignes commentées plus haut).